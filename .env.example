# Copy this to .env and fill in your values
ANTHROPIC_API_KEY=your_api_key_here

# Web server
FLASK_SECRET_KEY=change-this-to-a-random-string
ACCESS_PIN=                # Set a numeric PIN to protect the app (leave blank = no auth)
HOST=0.0.0.0               # 0.0.0.0 = accessible on local network
PORT=5000

# Optional: your own profile to give Claude context about you
MY_NAME=
MY_SKILLS=
MY_INDUSTRY=
MY_CURRENT_PROJECTS=
