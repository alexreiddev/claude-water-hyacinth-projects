# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Web server ────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=change-this-to-a-random-string
HOST=0.0.0.0          # 0.0.0.0 = accessible on local network
PORT=5000
FLASK_DEBUG=0

# ── Optional: live search (greatly improves recommendations) ──────────────────
# YouTube Data API v3 key — for searching trusted YouTube review channels
# Get it at: https://console.developers.google.com → Credentials → API Key
# Enable "YouTube Data API v3"
YOUTUBE_API_KEY=

# Google Custom Search API key + Search Engine ID (CX)
# Get API key at: https://console.developers.google.com → Credentials → API Key
# Create a Search Engine at: https://programmablesearchengine.google.com
# Enable "Search the entire web"
GOOGLE_API_KEY=
GOOGLE_SEARCH_CX=
